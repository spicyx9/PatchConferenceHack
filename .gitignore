# Collected data (private / potentially licensed)
raw/
probes/*.json
probes/*.html
probes/*.ndjson
# Bright Data LinkedIn records (public profiles of real people); data/block_matrix.json stays tracked
data/probes/linkedin_*.json
# Bright Data Crunchbase raw rows (make probe-crunchbase); data/cache/crunchbase_public.json stays tracked
data/probes/crunchbase_*.json
# Bright Data Google Maps raw rows (scripts/probes/venues_google_maps.py); data/cache/venues.json stays tracked
data/probes/venues_google_maps_*.json

# Worker logs, PIDs, and snapshots (never upload provider responses or secrets)
/logs/

# Bright Data dataset snapshots (scripts/probes/flights_collect.py): scraped bodies, never committed
data/snapshots/

# Local drafts: never committed
*.draft
*.draft.md

# Refresh button: raw SERP answers (scraped bodies, never committed)
data/probes/refresh_serp_*.json

# Local artifact rendering and draft output (final brief is under docs/demo)
/tmp/
/output/
