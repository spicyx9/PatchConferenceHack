{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Bash(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git worktree remove*)",
      "Bash(git branch -D*)",
      "Bash(sudo *)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.secrets/**)"
    ]
  }
}
