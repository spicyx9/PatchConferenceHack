# Do not commit secrets. Copy to .env.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_TIMEOUT_SECONDS=30
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=conferge
CONFERGE_USE_FIXTURES=false
CONFERGE_LOG_LEVEL=INFO
# Optional future providers
SERPAPI_API_KEY=
OPENAI_API_KEY=

# FalkorDB host port, default 6379. Set e.g. 6380 when a local redis already holds 6379.
# Read by conferge.core.settings (env first, then .env) and by docker-compose.yml.
FALKORDB_PORT=6379
